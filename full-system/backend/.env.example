# ---- DDHT backend configuration (copy to .env and fill in) ----
# NEVER commit .env. The HF token is used by the backend only.

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER@localhost:5432/ddht

# JWT signing secret: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRE_MINUTES=120

# Email for the patient sign-up code (Gmail). SMTP_USER = the Gmail address; SMTP_PASSWORD = a 16-letter Google
# "app password" (Google account > Security > 2-Step Verification > App passwords), NOT the normal password.
# Leave blank to skip email: the code is then written to the backend log (local development only).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM_NAME=DDHT

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Document storage (local filesystem backend; pluggable)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=10
# Uploaders may delete their own upload within this many days
UPLOAD_UNDO_DAYS=7
# How far ahead patients can book appointments
BOOKING_WINDOW_DAYS=30
# UPLOAD_DIR=./storage/uploads
# CHROMA_DIR=./storage/chroma

# ---- AI ----
# Main provider: groq | ollama | huggingface | cerebras | deepseek | openrouter | gemini
# Default: GPT-OSS 120B on Groq (free key below; fictional data only, the question and records go to Groq),
# with MedGemma on this computer as the automatic backup when Groq is busy or offline.
LLM_PROVIDER=groq
# MedGemma backup through Ollama (free, no key, nothing leaves this computer):
#   1. Install Ollama: https://ollama.com/download   2. ollama pull medgemma1.5:4b   (about 3.3 GB)
OLLAMA_MODEL=medgemma1.5:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
# Backups tried automatically if the main one hits its limit: "provider" or "provider:model",
# e.g. LLM_FALLBACKS=groq:qwen/qwen3.8-27b,openrouter
LLM_FALLBACKS=groq:openai/gpt-oss-20b,gemini,ollama
# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Separate Groq account, only for reading scans/photos of doctors' certificates (never photo IDs)
DOCTOR_DOC_GROQ_API_KEY=your_second_groq_api_key_here
# Cerebras (free tier, about 1M tokens/day) - https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# DeepSeek (paid after the sign-up credit) - https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenRouter (free models end in ":free", about 50 requests/day) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Google Gemini (free tier with rate limits) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Check any change with:  .venv/bin/python -m app.modules.ai.check
HF_TOKEN=your_actual_token_here
# Hosted MedGemma 27B (not free: enable the "featherless-ai" provider in your Hugging Face
# settings and accept the model's terms; paid credit after the small monthly allowance)
HF_MODEL=google/medgemma-27b-text-it
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Document search (vector database) embeddings:
# ollama      = all-MiniLM-L6-v2 on this computer (default, free; run: ollama pull all-minilm)
# huggingface = HF Inference API embeddings (requires HF_TOKEN and Hugging Face credit)
# hash        = local deterministic lexical embeddings (offline dev / tests)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=all-minilm
AI_TIMEOUT_SECONDS=60
RAG_TOP_K=6
RAG_MAX_DISTANCE=1.0


# Optional Decision support tab for doctors (scores, trends, medication safety, symptom match). Set false to switch it off.
DECISION_SUPPORT_ENABLED=true
